{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epsimlab-site",
  "main": "worker/landing.js",
  "compatibility_date": "2026-05-22",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "epsimlab.com",
      "custom_domain": true
    },
    {
      "pattern": "www.epsimlab.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false
}
